# =========================================================
# Python
# =========================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# =========================================================
# Virtual environments
# =========================================================
.venv/
venv/
env/
ENV/

# =========================================================
# Python tooling caches
# =========================================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# =========================================================
# Jupyter
# =========================================================
.ipynb_checkpoints/

# =========================================================
# Build and packaging
# =========================================================
build/
dist/
*.egg-info/
.eggs/

# =========================================================
# Datasets (regenerables, no se versionan)
# =========================================================
data/*
!data/.gitkeep
data/processed/*.npz

# =========================================================
# Trained models (regenerables con train.py)
# =========================================================
models/*
!models/.gitkeep

# =========================================================
# Experimental results
#
# Politica: se ignoran salidas crudas, voluminosas o
# regenerables. Se versiona explicitamente la evidencia
# validada del proyecto.
# =========================================================

# Crudos y regenerables: ignorados (solo se conserva la carpeta)
results/raw/*
!results/raw/.gitkeep
results/processed/*
!results/processed/.gitkeep
results/manifests/*
!results/manifests/.gitkeep

# Figuras: ignoradas por defecto, salvo las aprobadas
results/figures/*
!results/figures/.gitkeep
!results/figures/preactivation_act1_histogram.png
!results/figures/preactivation_act2_histogram.png
!results/figures/preactivation_act3_histogram.png
!results/figures/preactivation_channel_ranges.png

# Excepción: figuras del Hito 3B
!results/figures/hito3b/
!results/figures/hito3b/**

# Excepción: figuras del Hito 3C
!results/figures/hito3c/
!results/figures/hito3c/**

# Evidencia validada del Hito 2: se versiona
!results/published/
!results/published/**

# Nota: results/approximations, results/pilots y results/tables
# NO se ignoran (son evidencia del Hito 3, se versionan por defecto).

# =========================================================
# Logs and temporary files
# =========================================================
*.log
*.tmp
*.temp
*.bak
*.swp
~$*

# =========================================================
# PowerShell session transcripts
# =========================================================
logs/powershell/*
!logs/powershell/.gitkeep

# =========================================================
# IDE and operating system
# =========================================================
.vscode/*
!.vscode/settings.json
.DS_Store
Thumbs.db
desktop.ini

# =========================================================
# Secrets and local environment files
# =========================================================
.env
.env.*
*.key
*.pem
*.pfx
*.p12

# =========================================================
# Native compilation artifacts (Pyfhel / SEAL build)
# =========================================================
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.obj
*.lib
*.dll
*.exp

# Claves CKKS: nunca versionar
artifacts/ckks/keys/
*.key

# Excepcion: figuras del Hito 4
!results/figures/hito4/
!results/figures/hito4/**

# Excepcion: figuras del Hito 6
!results/figures/hito6/
!results/figures/hito6/**

# Carpeta de demostracion para exposicion (uso local, no versionar)
/demo/
